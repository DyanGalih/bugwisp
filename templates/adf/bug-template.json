                {
                  "type": "strong"
                }
              ]
            },
            {
              "type": "text",
              "text": "[CVSS v4.0 vector or N/A]"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "CVSS Calculator URL: ",
