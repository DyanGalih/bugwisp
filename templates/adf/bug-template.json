          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 4
          },
          "content": [
            {
              "type": "text",
              "text": "Impact"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "[Explain the business and security risk if exploited.]"
            }
          ]
        },
        {
          "type": "panel",
          "attrs": {
            "panelType": "warning"
          },
          "content": [
