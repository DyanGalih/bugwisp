                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "[Step 2]"
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "[Step 3]"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "rule"
        },
        {
          "type": "panel",
          "attrs": {
            "panelType": "note"
          },
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Evidence / POC",
                  "marks": [
                    {
                      "type": "strong"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "[Provide request/response snippets, curl commands, screenshots, or notes proving the issue.]"
            }
          ]
        },
        {
          "type": "codeBlock",
          "attrs": {
            "language": "text"
          },
          "content": [
            {
              "type": "text",
              "text": "[PoC Code/Response Snippet]"
            }
          ]
        },
        {
          "type": "rule"
        },
        {
          "type": "panel",
          "attrs": {
            "panelType": "success"
          },
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Recommendation",
                  "marks": [
                    {
                      "type": "strong"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "[Provide specific, actionable remediation steps.]"
            }
          ]
        },
        {
          "type": "rule"
        },
        {
          "type": "panel",
          "attrs": {
            "panelType": "info"
          },
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Validation Details",
                  "marks": [
                    {
                      "type": "strong"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Observed Result: ",
              "marks": [
                {
                  "type": "strong"
                }
              ]
            },
            {
              "type": "text",
              "text": "[What was actually seen]"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Expected Result: ",
              "marks": [
                {
                  "type": "strong"
                }
              ]
            },
            {
              "type": "text",
              "text": "[What should have happened]"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Verification: ",
              "marks": [
                {
                  "type": "strong"
                }
              ]
            },
            {
              "type": "text",
              "text": "[How to confirm the fix]"
            }
          ]
