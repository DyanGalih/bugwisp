# Jira Configuration
JIRA_BOARD_URL=https://your-org.atlassian.net/jira/software/projects/YOUR_PROJECT_KEY/boards/0
JIRA_BOARD_ID=0
JIRA_PROJECT_KEY=YOUR_PROJECT_KEY
JIRA_PARENT_ISSUE=YOUR_PROJECT_KEY-0
#access https://[workspace].atlassian.net/_edge/tenant_info via browser to get the JIRA_CLOUD_ID
JIRA_CLOUD_ID=ID_FROM_JIRA_CLOUD_API
JIRA_ISSUE_TYPE=Bug
JIRA_RESPONSE_CONTENT_FORMAT=markdown
# Reporting Template Configuration
# Output format: "markdown" (default, for copy-paste) or "adf" (for Jira API/MCP)
REPORT_FORMAT=markdown

# Also save a local Markdown copy under reporting/output/markdown when using ADF/Jira
GENERATE_MARKDOWN_COPY=true

# Path to the markdown template (used when REPORT_FORMAT=markdown)
REPORT_TEMPLATE_PATH=templates/markdown/bug-template.md

# Path to the ADF template (used when REPORT_FORMAT=adf)
ADF_TEMPLATE_PATH=templates/adf/bug-template.json